  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "hikari-prometheus"},
      "description": "1 means the selected exporter target is reachable; 0 means Prometheus cannot scrape it.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [{"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "min(up{job=\"tavily-hikari\",service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"})", "instant": true, "refId": "A"}],
      "title": "Target health",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hikari-prometheus"},
      "description": "Completed or terminally rejected requests per second over the last five minutes.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "hikari:request_rate5m{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}", "instant": true, "refId": "A"}],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hikari-prometheus"},
      "description": "Share of requests ending in error, timeout, or exhausted upstream retries.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.05}, {"color": "red", "value": 0.2}]}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "hikari:error_rate5m{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}", "instant": true, "refId": "A"}],
      "title": "Error rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hikari-prometheus"},
      "description": "95th percentile of completed request duration; compare with the phase panel below to locate the wait.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 3, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 2}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "hikari:request_p95_seconds5m{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}", "instant": true, "refId": "A"}],
      "title": "Request P95",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hikari-prometheus"},
      "description": "Number of request samples observed in the five-minute window. Use this to judge whether a percentile has enough traffic behind it.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 10}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "hikari:sample_count5m{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}", "instant": true, "refId": "A"}],
      "title": "Samples / 5m",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hikari-prometheus"},
      "description": "Observed memory headroom before the configured process or cgroup limit.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 134217728}, {"color": "green", "value": 536870912}]}, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "id": 6,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "hikari:memory_headroom_bytes{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}", "instant": true, "refId": "A"}],
      "title": "Memory headroom",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hikari-prometheus"},
      "description": "Traffic volume split by the bounded route family label.",
      "fieldConfig": {"defaults": {"decimals": 2, "custom": {"drawStyle": "line", "fillOpacity": 12, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (route_family) (rate(hikari_http_requests_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{route_family}}", "refId": "A"}],
      "title": "Request rate by route family",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hikari-prometheus"},
      "description": "Error share by route family. A spike here identifies the affected business surface before looking at upstream or storage panels.",
      "fieldConfig": {"defaults": {"decimals": 2, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.05}, {"color": "red", "value": 0.2}]}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (route_family) (rate(hikari_http_requests_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\",outcome=~\"error|timeout|upstream_exhausted\"}[5m])) / clamp_min(sum by (route_family) (rate(hikari_http_requests_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[5m])), 0.001)", "legendFormat": "{{route_family}}", "refId": "A"}],
      "title": "Error rate by route family",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hikari-prometheus"},
      "description": "Overall request latency at three percentiles. Divergence between P50 and P99 indicates tail contention or retries.",
      "fieldConfig": {"defaults": {"decimals": 3, "custom": {"drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 16, "x": 0, "y": 12},
      "id": 9,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "hikari:request_p50_seconds5m{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}", "legendFormat": "P50", "refId": "A"},
        {"expr": "hikari:request_p95_seconds5m{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}", "legendFormat": "P95", "refId": "B"},
        {"expr": "hikari:request_p99_seconds5m{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}", "legendFormat": "P99", "refId": "C"}
      ],
      "title": "Request latency percentiles",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hikari-prometheus"},
      "description": "Terminal request outcomes, useful for separating traffic loss from latency-only degradation.",
      "fieldConfig": {"defaults": {"decimals": 2, "custom": {"drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "showPoints": "never", "stacking": {"group": "A", "mode": "normal"}, "spanNulls": true}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
      "id": 10,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (outcome) (rate(hikari_http_requests_total{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{outcome}}", "refId": "A"}],
      "title": "Request outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "hikari-prometheus"},
      "description": "P95 duration by bounded request phase. The highest line identifies the first place to investigate.",
      "fieldConfig": {"defaults": {"decimals": 3, "custom": {"drawStyle": "line", "fillOpacity": 12, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "id": 11,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "hikari:request_phase_p95_seconds5m{service=~\"$service\",environment=~\"$environment\",instance=~\"$instance\"}", "legendFormat": "{{phase}}", "refId": "A"}],
      "title": "Request phase P95",
      "type": "timeseries"
    }
  ],
